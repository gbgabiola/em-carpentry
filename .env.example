# Approved public HTTPS origin; leave blank for local development.
SITE_URL=
# Keep false until content, privacy and deployment have passed the launch gate. Rebuild after changes.
SITE_INDEXING_ENABLED=false
# On Netlify, configure these values in the UI for Builds AND Functions; .env.local stays local.
# Server-side Supabase configuration. Leave BOTH blank to run without a backend.
# Supabase connection and schema setup: docs/backend-setup.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Use a publishable key (or legacy anon key). Never put a secret/service-role key here.
# Public submissions have no enable flag: a future reviewed intake migration/handler and abuse controls are required. The retention job does not enable forms.

# Offline check:backup needs no environment variables or provider credentials.
